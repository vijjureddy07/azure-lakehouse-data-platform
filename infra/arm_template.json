{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "description": "ARM Template provisioning ADLS Gen2 with HNS, Azure Data Factory with Managed Identity, and RBAC Role Assignment for Module 2."
  },
  "parameters": {
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": {
        "description": "Primary Azure deployment region"
      }
    },
    "environment": {
      "type": "string",
      "defaultValue": "dev",
      "allowedValues": [
        "dev",
        "test",
        "prod"
      ],
      "metadata": {
        "description": "Deployment environment tier"
      }
    },
    "storageAccountName": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Name of ADLS Gen2 storage account (lowercase alphanumeric, <= 24 chars). If empty, a unique name is generated deterministically."
      }
    },
    "dataFactoryName": {
      "type": "string",
      "defaultValue": "adf-lakehouse-dev",
      "metadata": {
        "description": "Name of Azure Data Factory instance"
      }
    },
    "containerName": {
      "type": "string",
      "defaultValue": "lakehouse",
      "metadata": {
        "description": "Name of primary ADLS Gen2 filesystem container"
      }
    }
  },
  "variables": {
    "resolvedStorageAccountName": "[if(empty(parameters('storageAccountName')), take(toLower(concat('stlakehouse', parameters('environment'), uniqueString(resourceGroup().id))), 24), toLower(parameters('storageAccountName')))]",
    "storageBlobDataContributorRoleId": "ba92f5b4-2d11-453d-a403-e96b0029c9fe",
    "roleAssignmentGuid": "[guid(resourceId('Microsoft.Storage/storageAccounts', variables('resolvedStorageAccountName')), resourceId('Microsoft.DataFactory/factories', parameters('dataFactoryName')), variables('storageBlobDataContributorRoleId'))]"
  },
  "resources": [
    {
      "type": "Microsoft.Storage/storageAccounts",
      "apiVersion": "2023-01-01",
      "name": "[variables('resolvedStorageAccountName')]",
      "location": "[parameters('location')]",
      "sku": {
        "name": "Standard_LRS"
      },
      "kind": "StorageV2",
      "properties": {
        "isHnsEnabled": true,
        "accessTier": "Hot",
        "supportsHttpsTrafficOnly": true,
        "minimumTlsVersion": "TLS1_2",
        "allowBlobPublicAccess": false
      },
      "tags": {
        "Environment": "[parameters('environment')]",
        "Project": "AzureLakehouseDataPlatform",
        "Module": "Module2_CloudIngestion"
      }
    },
    {
      "type": "Microsoft.Storage/storageAccounts/blobServices/containers",
      "apiVersion": "2023-01-01",
      "name": "[format('{0}/default/{1}', parameters('storageAccountName'), parameters('containerName'))]",
      "dependsOn": [
        "[resourceId('Microsoft.Storage/storageAccounts', parameters('storageAccountName'))]"
      ],
      "properties": {
        "publicAccess": "None"
      }
    },
    {
      "type": "Microsoft.DataFactory/factories",
      "apiVersion": "2018-06-01",
      "name": "[parameters('dataFactoryName')]",
      "location": "[parameters('location')]",
      "identity": {
        "type": "SystemAssigned"
      },
      "tags": {
        "Environment": "[parameters('environment')]",
        "Project": "AzureLakehouseDataPlatform",
        "Module": "Module2_CloudIngestion"
      }
    },
    {
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2022-04-01",
      "name": "[variables('roleAssignmentGuid')]",
      "scope": "[format('Microsoft.Storage/storageAccounts/{0}', variables('resolvedStorageAccountName'))]",
      "dependsOn": [
        "[resourceId('Microsoft.Storage/storageAccounts', variables('resolvedStorageAccountName'))]",
        "[resourceId('Microsoft.DataFactory/factories', parameters('dataFactoryName'))]"
      ],
      "properties": {
        "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', variables('storageBlobDataContributorRoleId'))]",
        "principalId": "[reference(resourceId('Microsoft.DataFactory/factories', parameters('dataFactoryName')), '2018-06-01', 'Full').identity.principalId]",
        "principalType": "ServicePrincipal"
      }
    },
    {
      "type": "Microsoft.Databricks/workspaces",
      "apiVersion": "2023-02-01",
      "name": "[concat('dbw-lakehouse-', parameters('environment'))]",
      "location": "[parameters('location')]",
      "sku": {
        "name": "premium"
      },
      "properties": {
        "managedResourceGroupId": "[subscriptionResourceId('Microsoft.Resources/resourceGroups', concat('rg-dbw-managed-', parameters('environment'), '-', uniqueString(resourceGroup().id)))]"
      },
      "tags": {
        "Environment": "[parameters('environment')]",
        "Project": "AzureLakehouseDataPlatform",
        "Module": "Module3_Databricks_Delta_Medallion"
      }
    },
    {
      "type": "Microsoft.Databricks/accessConnectors",
      "apiVersion": "2023-05-01",
      "name": "[concat('dbx-access-connector-', parameters('environment'))]",
      "location": "[parameters('location')]",
      "identity": {
        "type": "SystemAssigned"
      },
      "tags": {
        "Environment": "[parameters('environment')]",
        "Project": "AzureLakehouseDataPlatform",
        "Module": "Module3_Databricks_Delta_Medallion"
      }
    }
  ],
  "outputs": {
    "storageAccountId": {
      "type": "string",
      "value": "[resourceId('Microsoft.Storage/storageAccounts', variables('resolvedStorageAccountName'))]"
    },
    "dataFactoryId": {
      "type": "string",
      "value": "[resourceId('Microsoft.DataFactory/factories', parameters('dataFactoryName'))]"
    },
    "dataFactoryPrincipalId": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.DataFactory/factories', parameters('dataFactoryName')), '2018-06-01', 'Full').identity.principalId]"
    },
    "databricksWorkspaceId": {
      "type": "string",
      "value": "[resourceId('Microsoft.Databricks/workspaces', concat('dbw-lakehouse-', parameters('environment')))]"
    },
    "databricksAccessConnectorId": {
      "type": "string",
      "value": "[resourceId('Microsoft.Databricks/accessConnectors', concat('dbx-access-connector-', parameters('environment')))]"
    }
  }
}
